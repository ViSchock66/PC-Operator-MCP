# Dependencias y estado privado en ejecución (PIN, OAuth, API keys, handoffs)
node_modules/
data/
.backups/
playground/

# Respaldos manuales y logs
*.bak-*
*.log
*.tmp

# Binario nativo de bandeja (se recompila automáticamente desde panel/tray/TrayDaemon.cs)
panel/tray/*.exe
panel/tray/*.exe.bak
panel/tray/*.old.*

# Host nativo WebView2 (se compila con .NET 8 SDK o se descarga desde GitHub Releases; fallback automático a navegador)
panel/host/bin/
panel/host/obj/
panel/host/dist/
release-artifacts/
