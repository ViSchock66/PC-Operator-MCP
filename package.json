{
  "name": "pc-operator-mcp",
  "version": "0.5.0",
  "description": "Local Windows Streamable HTTP MCP server with OAuth 2.1, workspace-scoped file tools, full-user PowerShell commands, cross-model handoff, bundled skills, and optional Antigravity Operator federation",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "tunnel": "node src/launcher.js",
    "panel": "powershell -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File panel/abrir-panel.ps1",
    "build:assets": "node scripts/build-ui-assets.mjs",
    "build:css": "tailwindcss -i ./src/ui/styles.css -o ./src/public/styles.css --minify",
    "build:ui": "npm run build:assets && npm run build:css",
    "watch:css": "tailwindcss -i ./src/ui/styles.css -o ./src/public/styles.css --watch",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/cli": "^4.3.5",
    "lucide-static": "^1.81.0",
    "simple-icons": "^16.38.1",
    "tailwindcss": "^4.3.5"
  }
}
