{
  "name": "gemini-pc-mcp",
  "version": "0.1.0",
  "description": "Servidor MCP Streamable HTTP + OAuth 2.1 para conectar gemini.google.com a un workspace local en Windows",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "tunnel": "node src/launcher.js",
