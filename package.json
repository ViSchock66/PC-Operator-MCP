{
  "name": "pc-operator-mcp",
  "version": "0.9.0",
  "description": "Local Windows Streamable HTTP MCP server with OAuth 2.1, workspace-scoped file tools, full-user PowerShell commands, cross-model handoff, bundled skills, and optional Antigravity Operator federation",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "tunnel": "node src/launcher.js",
    "panel": "powershell -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File panel/abrir-panel.ps1",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "test:web": "vitest run --config web/vite.config.ts",
    "check": "npm run typecheck && npm run test:web && npm run build:web && npm test",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@fluentui/svg-icons": "^1.1.347",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.4",
    "@tailwindcss/vite": "^4.3.5",
    "preact": "^11.2.0",
    "simple-icons": "^16.38.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.4"
  }
}
